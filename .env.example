# ProjectOps backend configuration.
# Copy this file to .env for local development. Never commit real secrets.

PROJECTOPS_APP_NAME=ProjectOps Backend
PROJECTOPS_ENVIRONMENT=local

# Local Docker Compose database.
PROJECTOPS_DATABASE_URL=postgresql+psycopg://projectops:projectops@localhost:55432/projectops

# Optional test database override. Backend tests default to projectops_test.
PROJECTOPS_TEST_DATABASE_URL=postgresql+psycopg://projectops:projectops@localhost:55432/projectops_test

# Manual health-check request timeout in seconds.
PROJECTOPS_HEALTH_CHECK_TIMEOUT_SECONDS=5

# Backend application log level.
PROJECTOPS_LOG_LEVEL=INFO

# Optional external error monitoring. Leave disabled locally unless testing a
# provider setup. Never commit a real DSN.
PROJECTOPS_ENABLE_ERROR_MONITORING=false
PROJECTOPS_SENTRY_DSN=
PROJECTOPS_SENTRY_ENVIRONMENT=local

# Local JWT signing secret. Replace with a strong secret in production.
PROJECTOPS_AUTH_SECRET_KEY=projectops-local-development-auth-secret-do-not-use-in-production
PROJECTOPS_ACCESS_TOKEN_EXPIRE_MINUTES=60
PROJECTOPS_GITHUB_APP_CLIENT_ID=
PROJECTOPS_GITHUB_APP_CLIENT_SECRET=
PROJECTOPS_GITHUB_APP_ID=
PROJECTOPS_GITHUB_APP_SLUG=
PROJECTOPS_GITHUB_APP_PRIVATE_KEY=
PROJECTOPS_GITHUB_APP_CALLBACK_URL=

# In-process fixed-window rate limits for auth and expensive actions.
PROJECTOPS_RATE_LIMIT_AUTH_LOGIN_ATTEMPTS=5
PROJECTOPS_RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=300
PROJECTOPS_RATE_LIMIT_AUTH_REGISTER_ATTEMPTS=5
PROJECTOPS_RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
PROJECTOPS_RATE_LIMIT_DEMO_SEED_ATTEMPTS=3
PROJECTOPS_RATE_LIMIT_DEMO_SEED_WINDOW_SECONDS=3600
PROJECTOPS_RATE_LIMIT_CODEMAP_RUN_ATTEMPTS=5
PROJECTOPS_RATE_LIMIT_CODEMAP_RUN_WINDOW_SECONDS=300
PROJECTOPS_RATE_LIMIT_HEALTH_CHECK_RUN_ATTEMPTS=10
PROJECTOPS_RATE_LIMIT_HEALTH_CHECK_RUN_WINDOW_SECONDS=300

# Comma-separated frontend origins allowed to call the backend.
# Production must list deployed frontend origins explicitly; do not use *.
PROJECTOPS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
