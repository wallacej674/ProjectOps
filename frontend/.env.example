# ProjectOps frontend configuration.
# Copy this file to .env.local for local development if you need to override defaults.

# Local FastAPI backend. Production deployments must set this to the deployed backend URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional external frontend error monitoring. Leave disabled unless a provider
# DSN is configured for the deployed environment. Never commit a real DSN.
VITE_ENABLE_ERROR_MONITORING=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
